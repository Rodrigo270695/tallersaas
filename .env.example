APP_NAME=TallerSaaS
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=es
APP_FALLBACK_LOCALE=es
APP_FAKER_LOCALE=es_PE
APP_TIMEZONE=America/Lima

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=tallersaas
DB_USERNAME=postgres
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# --------------------------------------------------------------------------
# Multi-tenancy (schema-per-tenant en PostgreSQL)
# --------------------------------------------------------------------------
# Local:      tallersaas.test (vía Herd/Valet + hosts), subdominios
#             {slug}.tallersaas.test
# Producción: tallersaas.orvae.pe es el dominio CENTRAL (panel del
#             superadmin, siempre exige login). Cada taller vive en
#             {slug}.tallersaas.orvae.pe.
TENANT_CENTRAL_DOMAINS="localhost,127.0.0.1,tallersaas.test"
TENANT_ROOT_DOMAIN=tallersaas.test
TENANT_SCHEMA_PREFIX=taller_
TENANT_CACHE_TTL=60
# TENANT_MIGRATION_SCHEMA= (uso interno de artisan, no tocar)

# --------------------------------------------------------------------------
# Orvae PE — provisioning de nuevos tenants (API interna firmada con HMAC)
# --------------------------------------------------------------------------
ORVAE_PROVISION_HMAC_SECRET=change-me
ORVAE_PROVISION_MAX_SKEW_SECONDS=300
ORVAE_PROVISION_IDEMPOTENCY_TTL_DAYS=30

# Dominio base donde cada tenant tiene su subdominio (slug.{TALLERSAAS_TENANT_DOMAIN})
TALLERSAAS_TENANT_SCHEME=http
TALLERSAAS_TENANT_DOMAIN=tallersaas.test
TALLERSAAS_TENANT_LOGIN_PATH=/login
TALLERSAAS_BOOTSTRAP_TTL_HOURS=48

BILLING_GRACE_DAYS=3

# --------------------------------------------------------------------------
# Superadmin de plataforma (seed inicial)
# --------------------------------------------------------------------------
PLATFORM_SUPERADMIN_NAME="Super Administrador"
PLATFORM_SUPERADMIN_EMAIL=superadmin@tallersaas.test
PLATFORM_SUPERADMIN_PASSWORD=ChangeMe123!

# Tenant de demostración (php artisan db:seed --class=DemoTenantSeeder).
# Queda accesible en https://{DEMO_TENANT_SLUG}.{TENANT_ROOT_DOMAIN}.
# Cada noche (02:00) tallersaas:reset-demo limpia datos y deja la sede prueba.
# DEMO_TENANT_SLUG=demo
# DEMO_TENANT_PLAN=pro
# DEMO_TENANT_ADMIN_EMAIL=admin@demo.orvae.pe
# DEMO_TENANT_ADMIN_PASSWORD=demo1234
# DEMO_TENANT_SEDE_CODIGO=CHI-01
# DEMO_TENANT_SEDE_NOMBRE="Sede prueba"

# --------------------------------------------------------------------------
# OpenWA (WhatsApp). Copia OPENWA_API_KEY desde el gateway; no la subas al repo.
# --------------------------------------------------------------------------
OPENWA_ENABLED=false
OPENWA_API_URL=https://wa.vetsaas.orvae.pe
OPENWA_API_KEY=
OPENWA_ADMIN_URL=https://wa-admin.vetsaas.orvae.pe
OPENWA_TIMEOUT_SECONDS=30
OPENWA_QUEUE_MAX_ATTEMPTS=3
OPENWA_PLATFORM_SESSION_NAME=tallersaas-platform

# --------------------------------------------------------------------------
# Onboarding (checklist en el dashboard del taller; no bloquea módulos)
# --------------------------------------------------------------------------
ONBOARDING_ENABLED=true
# ONBOARDING_ENABLED_SLUGS=taller-demo,taller-norte
ONBOARDING_PREVIEW=false

# --------------------------------------------------------------------------
# Consulta de DNI/RUC al crear clientes.
# ApiPerú (apiperu.dev) es la fuente PRIMARIA. APISUNAT es el RESPALDO,
# usado solo si ApiPerú falla (cuota, timeout, 5xx). Si no defines
# APISUNAT_LOOKUP_TOKEN, se intenta el token APISUNAT ya configurado en
# el taller para facturación electrónica.
# --------------------------------------------------------------------------
APIPERU_BASE_URL=https://apiperu.dev/api
APIPERU_TOKEN=
APISUNAT_LOOKUP_BASE_URL=https://dev.apisunat.pe/api/v1
APISUNAT_LOOKUP_TOKEN=

