APP_NAME=TallerSaaS
APP_ENV=testing
APP_KEY=base64:lQGV9pCjIu2qigNjHzXV/My40jk/sTozv4oD7lwyAR8=
APP_DEBUG=true
APP_URL=http://localhost

APP_TIMEZONE=America/Lima
APP_LOCALE=es
APP_FALLBACK_LOCALE=es
APP_FAKER_LOCALE=es_PE

BCRYPT_ROUNDS=4

# ─────────────────────────────────────────────────────────────────────
# BLINDAJE: los tests JAMÁS deben tocar la BD real (tallersaas en pgsql).
# Si necesitas correr tests contra Postgres real (multi-schema), hazlo
# de forma explícita exportando DB_CONNECTION=pgsql antes de pest,
# apuntando a una base cuyo nombre termine en `_test`/`_testing`.
# ─────────────────────────────────────────────────────────────────────
DB_CONNECTION=sqlite
DB_DATABASE=:memory:

SESSION_DRIVER=array
CACHE_STORE=array
QUEUE_CONNECTION=sync
MAIL_MAILER=array
BROADCAST_CONNECTION=null

PULSE_ENABLED=false
TELESCOPE_ENABLED=false
NIGHTWATCH_ENABLED=false

# ── Multi-tenancy en testing (los tests de Tenancy que requieren pgsql
# se saltan automáticamente si el driver no es pgsql) ──
TENANT_CENTRAL_DOMAINS="localhost,127.0.0.1,tallersaas.test"
TENANT_ROOT_DOMAIN=tallersaas.test
TENANT_SCHEMA_PREFIX=taller_
TENANT_CACHE_TTL=0

PLATFORM_SUPERADMIN_NAME="Super Test"
PLATFORM_SUPERADMIN_EMAIL=superadmin@test.local
PLATFORM_SUPERADMIN_PASSWORD=password

OPENWA_ENABLED=false
OPENWA_API_KEY=

